# identity-service database
DB_URL=jdbc:postgresql://localhost:5433/identity_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ledger-service database
LEDGER_DB_URL=jdbc:postgresql://localhost:5436/ledger_db
LEDGER_DB_USERNAME=postgres
LEDGER_DB_PASSWORD=postgres

# JWT security (DEV ONLY. Generate your own)
JWT_SECRET=ZGV2LW9ubHktc2VjcmV0LWtleS0zMi1ieXRlcy1taW4h
JWT_EXPIRATION_MS=86400000

# Idempotency key retention
LEDGER_IDEMPOTENCY_TTL=24h

# Kafka event broker
KAFKA_BOOTSTRAP_SERVERS=localhost:9093
KAFKA_ADMIN_AUTO_CREATE=true
KAFKA_TOPIC_TRANSFERS=ledger.transfers.v1

# Outbox poller
OUTBOX_POLLER_ENABLED=true
OUTBOX_POLLER_DELAY_MS=1000
OUTBOX_POLLER_BATCH_SIZE=50
OUTBOX_POLLER_MAX_RETRIES=3
OUTBOX_POLLER_TIMEOUT_SECONDS=5

# Database batch fetching
DB_BATCH_FETCH_SIZE=20

# statement-service database
MONGODB_URI=mongodb://localhost:27018/statement_db
MONGODB_DATABASE=statement_db

# statement-service Kafka consumer
KAFKA_STATEMENT_CONSUMER_GROUP=statement-service
KAFKA_TOPIC_TRANSFERS_DLT=ledger.transfers.v1.DLT

# api-gateway configuration
GATEWAY_PORT=8080
IDENTITY_SERVICE_URL=http://localhost:8081
LEDGER_SERVICE_URL=http://localhost:8082
STATEMENT_SERVICE_URL=http://localhost:8083
GATEWAY_CONNECT_TIMEOUT_MS=5000
GATEWAY_RESPONSE_TIMEOUT=10s

# Redis cache & rate limiting
REDIS_HOST=localhost
REDIS_PORT=6380
RATE_LIMIT_REPLENISH_RATE=10
RATE_LIMIT_BURST_CAPACITY=20

# Monitoring infrastructure
PROMETHEUS_PORT=9091
GRAFANA_PORT=3001
